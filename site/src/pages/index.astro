---
import BaseLayout from '../layouts/BaseLayout.astro';
import PathIcon from '../components/PathIcon.astro';
import { workflowPaths } from '../lib/specflow';
import { withBase } from '../lib/docs';
import { getVisibleCards, getCardBadges, type FlowCard } from '../lib/flow-viz';

const base = import.meta.env.BASE_URL;

// Path selection: minimal is the default path for the homepage board.
const defaultPathId = 'lean';
const defaultPath = workflowPaths.find((path) => path.id === defaultPathId) ?? workflowPaths[0];

// Keys that represent optional cards that are not required by every path.
const optionalCardKeys = ['100', '101', '102', '103', '104', '105', '106', '107', '108', '110'];

const flowRows: FlowCard[][] = [
  [
    { key: '100', title: 'Domain Knowledge', description: 'Research the domain, users, constraints, and differentiators.' },
    { key: '101', title: 'Project Overview', description: 'Define what the product is, who it serves, and why it matters.' },
    { key: '102', title: 'System Architecture', description: 'Set the stack, major components, and testing baseline.' },
    { key: '103', title: 'Common Data Model', description: 'Model relational data in DBML and non-relational data in Markdown.' },
    { key: '104', title: 'Backend Architecture', description: 'Specify API structure, services, data access, and security.' },
  ],
  [
    { key: '110', title: 'Feature Overview', description: 'Map the product into capabilities and thin vertical slices.' },
    { key: '108', title: 'Page Design', description: 'Loop on individual routes when a specific page needs detailed design.' },
    { key: '107', title: 'UI Experience', description: 'Define navigation, page inventory, and interaction commitments.' },
    { key: '106', title: 'UI Design', description: 'Set the visual system, typography, and component look and feel.' },
    { key: '105', title: 'Frontend Architecture', description: 'Define component boundaries, state rules, and integration patterns.' },
  ],
  [
    { key: '201', title: 'High-Level Design', description: 'Define one feature with scope and user journey.' },
    { key: '202', title: 'Spec Design', description: 'Write the Gherkin scenarios that describe expected behavior.' },
    { key: '301', title: 'Spec Implementation', description: 'Design and independently review before coding; build tests-first, then freshly review, refine, and validate.' },
  ],
];

const defaultVisibleCards = getVisibleCards(defaultPath.sequence, flowRows);
---

<BaseLayout currentPath={Astro.url.pathname} homeOnly={true}>
  <section class="home-hero container">
    <div class="home-hero__copy">
      <div class="home-hero__badge-row">
        <p class="eyebrow">SpecFlow</p>
        <span class="home-hero__claude-badge">Built for Claude Code</span>
      </div>
      <h1>Software, defined.</h1>
      <p class="home-hero__lede">A lightweight, spec-driven workflow for building with AI.</p>
      <p><strong>Just enough structure.</strong> Consistent, skimmable templates make the goal, key decisions, and expected behavior easy to review. Include only what the work needs: enough context and constraints to guide AI, with room for judgment about how to deliver it.</p>
    </div>

    <div class="home-hero__art" aria-hidden="true">
      <div class="home-hero__orb home-hero__orb--large"></div>
      <div class="home-hero__orb home-hero__orb--small"></div>
      <div class="home-hero__grid"></div>
      <div class="home-hero__ring home-hero__ring--one"></div>
      <div class="home-hero__ring home-hero__ring--two"></div>
    </div>
  </section>

  <section class="home-path-selection container" aria-labelledby="home-path-selection-title" data-path-selection data-flow-visualization data-default-path={defaultPathId}>
    <div class="home-path-selection__header">
      <h2 id="home-path-selection-title">Choose your path</h2>
      <p>Select the workflow that best fits your project's current needs and constraints.</p>
    </div>

    <div class="home-path-selection__controls" role="radiogroup" aria-label="Workflow paths">
      {workflowPaths.map((path) => (
        <label class:list={['home-path-selection__radio-label', { 'is-featured': path.id === defaultPathId, 'is-selected': path.id === defaultPathId }]}>
          <input
            type="radio"
            name="workflow-path"
            value={path.id}
            checked={path.id === defaultPathId}
            class="home-path-selection__radio"
            data-path-control={path.id}
            data-path-label={path.label}
            data-path-icon={path.icon}
            data-path-description={path.description}
            data-path-note={path.note}
            data-path-sequence={path.sequence}
            data-path-action={withBase(path.action, base)}
          />
          <span class="home-path-selection__path-option">
            <PathIcon class="home-path-selection__path-icon" name={path.icon} />
            <span class="home-path-selection__path-label">{path.label}</span>
          </span>
        </label>
      ))}
    </div>

    <div class="home-path-selection__board is-selected" data-path-panel={defaultPath.id} data-path-board>
      <div class="home-path-selection__path-meta">
        <p class="home-path-selection__kicker">Selected path</p>
        <h3 data-path-name>{defaultPath.label}</h3>
        <p data-path-description>{defaultPath.description}</p>
        <p class="home-path-selection__note" data-path-note>{defaultPath.note}</p>
        <a class="button button--primary home-path-selection__cta" data-path-action href={withBase(defaultPath.action, base)}>Get Started</a>
      </div>

      <div class="home-path-selection__steps">
        <p class="home-path-selection__steps-kicker">Visible steps</p>
        <div class="home-path-selection__rows" data-flow-rows data-flow-rows-json={JSON.stringify(flowRows)} data-optional-card-keys-json={JSON.stringify(optionalCardKeys)}>
          {defaultVisibleCards.map((card) => {
            const isOptional = optionalCardKeys.includes(card.key);
            const badges = getCardBadges(card.key);

            return (
              <article
                class:list={[
                  'home-path-selection__card',
                  {
                    'is-optional': isOptional,
                  },
                ]}
                data-step-key={card.key}
                data-optional={isOptional ? 'true' : undefined}
              >
                <div class="home-path-selection__card-topline">
                  <span class="home-path-selection__card-code">{card.key}</span>
                  {badges.map((badge) => (
                    <span class:list={['home-path-selection__card-badge', `is-${badge.tone}`]}>{badge.label}</span>
                  ))}
                </div>
                <h3 class="home-path-selection__card-title">{card.title}</h3>
                <p class="home-path-selection__card-description">{card.description}</p>
              </article>
            );
          })}
        </div>
        <p class="home-path-selection__note">Inside 301: in-memory design → two independent pre-implementation reviews (walkthrough + adversarial) → tests-first implementation → fresh post-implementation review and bounded refinement → final validation. <a href={withBase('/implementation/301-spec-implementation/', base)}>See the 301 phases →</a></p>
      </div>
    </div>
    <p class="home-path-selection__steps-kicker" aria-live="polite" data-path-status></p>
  </section>

  <section class="home-also-available container" aria-labelledby="home-also-available-title">
    <div class="home-also-available__header">
      <h2 id="home-also-available-title">Also available</h2>
      <p>Skills that sit outside the linear path — used situationally, not as a pipeline step.</p>
    </div>

    <div class="home-also-available__grid">
      <a class="home-also-available__feature" href={withBase('/orchestration/901-feature-loop/', base)}>
        <svg class="home-also-available__feature-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m17 2 4 4-4 4" />
          <path d="M3 11v-1a4 4 0 0 1 4-4h14" />
          <path d="m7 22-4-4 4-4" />
          <path d="M21 13v1a4 4 0 0 1-4 4H3" />
        </svg>
        <div class="home-also-available__feature-copy">
          <div class="home-path-selection__card-topline">
            <span class="home-path-selection__card-code">901</span>
            <span class="home-path-selection__card-badge is-loop">Feature Loop</span>
          </div>
          <h3>Run a feature end-to-end, headless</h3>
          <p>One command drives the full pipeline — design, specs, per-scenario build-out, cleanup, and a merge back to the base branch — as a single git-tracked run.</p>
          <span class="home-also-available__feature-cta">See how it works →</span>
        </div>
      </a>

      <div class="home-also-available__row">
        <a class="home-also-available__card" href={withBase('/implementation/302-test-implementation/', base)}>
          <span class="home-path-selection__card-code">302</span>
          <h3>Test Implementation</h3>
          <p>Add or repair automated tests when the production behavior already exists.</p>
        </a>

        <a class="home-also-available__card" href={withBase('/cleanup/401-cleanup/', base)}>
          <span class="home-path-selection__card-code">401</span>
          <h3>Cleanup</h3>
          <p>Run an optional, separate cleanup pass on a defined source or test scope.</p>
        </a>
      </div>

      <div class="home-also-available__row">
        <a class="home-also-available__card" href={withBase('/orchestration/900-feedback-loop/', base)}>
          <span class="home-path-selection__card-code">900</span>
          <h3>Feedback Loop</h3>
          <p>Bounded review/apply-fix convergence cycle around any artifact or change set.</p>
        </a>

        <a class="home-also-available__card" href={withBase('/cleanup/402-test-correction/', base)}>
          <span class="home-path-selection__card-code">402</span>
          <h3>Test Correction</h3>
          <p>Triage a failing test to decide whether the fix belongs in the test, the source, or the intended behavior.</p>
        </a>
      </div>

      <div class="home-also-available__row">
        <a class="home-also-available__card" href={withBase('/quality-assurance/501-browser-qa-analyst/', base)}>
          <span class="home-path-selection__card-code">501</span>
          <h3>Browser QA Analyst</h3>
          <p>Drive a real, visible Chrome browser through a live site like a QA analyst, logging anything broken or unintuitive to a running defect backlog.</p>
        </a>

        <a class="home-also-available__card" href={withBase('/quality-assurance/502-defect-resolution/', base)}>
          <span class="home-path-selection__card-code">502</span>
          <h3>Defect Resolution</h3>
          <p>Work the defect backlog toward resolution, dispatching each entry to 402 for reproduction, classification, and a real fix.</p>
        </a>
      </div>
    </div>
  </section>

  <script>
    import { getVisibleCards, getCardBadges, type FlowCard } from '../lib/flow-viz';

    const pathSelection = document.querySelector('[data-path-selection]');

    if (pathSelection) {
      const controls = Array.from(pathSelection.querySelectorAll<HTMLInputElement>('[data-path-control]'));
      const board = pathSelection.querySelector<HTMLElement>('[data-path-board]');
      const name = board?.querySelector<HTMLElement>('[data-path-name]');
      const description = board?.querySelector<HTMLElement>('[data-path-description]');
      const note = board?.querySelector<HTMLElement>('[data-path-note]');
      const cta = board?.querySelector<HTMLAnchorElement>('[data-path-action]');
      const flowRowsEl = pathSelection.querySelector<HTMLElement>('[data-flow-rows]');
      const status = pathSelection.querySelector<HTMLElement>('[data-path-status]');

      const flowRows: FlowCard[][] = JSON.parse(flowRowsEl?.dataset.flowRowsJson ?? '[]');
      const optionalCardKeys: string[] = JSON.parse(flowRowsEl?.dataset.optionalCardKeysJson ?? '[]');

      const buildCardHTML = (card: FlowCard): string => {
        const isOptional = optionalCardKeys.includes(card.key);
        const badges = getCardBadges(card.key)
          .map((badge) => `<span class="home-path-selection__card-badge is-${badge.tone}">${badge.label}</span>`)
          .join('');
        const classes = ['home-path-selection__card', isOptional && 'is-optional'].filter(Boolean).join(' ');

        return `<article class="${classes}" data-step-key="${card.key}"${isOptional ? ' data-optional="true"' : ''}>
  <div class="home-path-selection__card-topline">
    <span class="home-path-selection__card-code">${card.key}</span>
    ${badges}
  </div>
  <h3 class="home-path-selection__card-title">${card.title}</h3>
  <p class="home-path-selection__card-description">${card.description}</p>
</article>`;
      };

      const rebuildCards = (activeSequence: string): void => {
        if (!flowRowsEl) return;
        const visibleCards = getVisibleCards(activeSequence, flowRows);
        flowRowsEl.innerHTML = visibleCards.map(buildCardHTML).join('');
      };

      const setActivePath = (nextId: string): void => {
        const activeControl = controls.find((c) => c.getAttribute('data-path-control') === nextId);
        if (!activeControl) return;

        const activeSequence = activeControl.getAttribute('data-path-sequence');
        if (!activeSequence) {
          console.warn(`[flow-viz] No data-path-sequence for path "${nextId}". Board not updated.`);
          return;
        }

        controls.forEach((control) => {
          const isActive = control.getAttribute('data-path-control') === nextId;
          control.checked = isActive;
          control.closest('.home-path-selection__radio-label')?.classList.toggle('is-selected', isActive);
        });

        if (board) board.setAttribute('data-path-panel', nextId);
        if (name) name.textContent = activeControl.getAttribute('data-path-label') ?? '';
        if (description) description.textContent = activeControl.getAttribute('data-path-description') ?? '';
        if (note) note.textContent = activeControl.getAttribute('data-path-note') ?? '';
        if (cta) cta.href = activeControl.getAttribute('data-path-action') ?? '#';

        rebuildCards(activeSequence);
        if (status) status.textContent = `${activeControl.dataset.pathLabel} selected.`;
      };

      controls.forEach((control) => {
        control.addEventListener('change', () => {
          const nextId = control.getAttribute('data-path-control');
          if (nextId) setActivePath(nextId);
        });
      });

      setActivePath(pathSelection.getAttribute('data-default-path') ?? controls[0]?.getAttribute('data-path-control') ?? '');
    }
  </script>
</BaseLayout>
